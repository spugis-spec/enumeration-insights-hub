rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers (existing app) ----------
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isOwnerUid() { return signedIn() && request.auth.uid == 'DYF3J9cWSQgSeGQu925tcef8mdU2'; }
    function isAdminOrEditor() { return signedIn() && role() in ['admin', 'editor']; }
    function isHubAdmin() { return isOwnerUid() || (signedIn() && role() == 'admin'); }
    function isHubStaff() { return isHubAdmin() || (signedIn() && role() in ['editor', 'supervisor']); }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    // ---------- Helpers (enumeration app) ----------
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasProfile() && me().role == 'admin'; }
    function isStaff() { return hasProfile() && me().role in ['admin', 'supervisor']; }

    // ---------- Shared: users ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if
        // existing app: self-signup as viewer
        (isOwner(userId)
          && request.resource.data.keys().hasAll(['uid', 'email', 'role'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'viewer')
        // enumeration app: admin creates profiles
        || isAdmin()
        // enumeration app: first-admin bootstrap
        || (signedIn() && request.auth.uid == userId && request.resource.data.role == 'admin'
          && !exists(/databases/$(database)/documents/meta/setup)
          && getAfter(/databases/$(database)/documents/meta/setup).data.adminUid == request.auth.uid);

      allow update, delete: if isHubAdmin() || isAdmin();
    }

    // ---------- Existing app ----------
    match /schedules/{dateId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (isAdminOrEditor() || isOwnerUid());
      allow delete: if isAdminOrEditor();
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (isAdminOrEditor() || isOwnerUid());
      allow delete: if isAdminOrEditor();
    }

    match /hub/{docId} {
      allow read: if isHubStaff();
      allow write: if isHubAdmin()
        || (isHubStaff() && docId in ['alloc', 'vehicles', 'notes']);
    }

    // ---------- Enumeration app ----------
    match /meta/setup {
      allow get: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/meta/setup)
        && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /feeders/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /enumerators/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /submissions/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /capture_issues/{id} { allow read, delete: if isStaff(); allow create, update: if isAdmin(); }
    match /vehicles/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    match /dts/{id} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'status_note', 'updated_at', 'updated_by']));
    }

    match /snapshots/{id} { allow read, write: if isAdmin(); }
    match /snapshot_chunks/{id} { allow read, write: if isAdmin(); }
    match /uploads/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /allocations/{id} { allow read, write: if isStaff(); }
    match /trips/{id} { allow read, write: if isStaff(); }

    // ---------- Capture Alerts answers (added) ----------
    // Saved answers such as "Resigned" or "Corrected". Staff can read them; only admins write.
    match /alert_resolutions/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    // ---------- Weekly Report (added) ----------
    // The account owner, plus anyone with a profile role of admin, editor or supervisor.
    function weeklyAccess() {
      return isOwnerUid() || (hasProfile() && me().role in ['admin', 'editor', 'supervisor']);
    }
    match /weekly_feederLookup/{id}   { allow read, write: if weeklyAccess(); }
    match /weekly_currentReport/{id}  { allow read, write: if weeklyAccess(); }
    match /weekly_previousReport/{id} { allow read, write: if weeklyAccess(); }
    match /weekly_savedWeeks/{id}     { allow read, write: if weeklyAccess(); }
  }
}
